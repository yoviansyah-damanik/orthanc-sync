							"raw": "{\n  \"accession_number\": \"DOC20260001\",\n  \"patient_id\": \"RM123456\",\n  \"patient_name\": \"DOE^JOHN\",\n  \"procedure_desc\": \"Hasil Ekspertise Radiologi\",\n  \"file_b64\": \"JVBERi0xLjQKJ...\",\n  \"send_to_pacs\": true\n}",
